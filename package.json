{
  "name": "@oxhive/ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0",
    "bun": ">=1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxHive/ui-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "src/tailwind-preset.js"
  ],
  "main": "./dist/oxhive-ui.js",
  "module": "./dist/oxhive-ui.js",
  "exports": {
    ".": "./dist/oxhive-ui.js",
    "./style.css": "./dist/oxhive-ui.css",
    "./tokens.css": "./src/tokens.css",
    "./tailwind-preset.js": "./src/tailwind-preset.js"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "prepare": "vite build",
    "playground": "vite --config playground/vite.config.js",
    "build:playground": "vite build --config playground/vite.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-vue": "^10",
    "globals": "^17",
    "jsdom": "^30.1.1",
    "prettier": "^3",
    "vite": "^8.3.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.43"
  }
}
